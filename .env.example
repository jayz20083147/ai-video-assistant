# Mistral AI API Key (Required for Summarization, Extraction, and RAG Answers)
# Get a free key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (Optional: for Hindi / Hinglish Speech-to-Text)
# Get an API key at: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Default Whisper Model Size ('tiny', 'base', 'small', 'medium')
DEFAULT_WHISPER_MODEL=small

# Default Language Routing: 'auto', 'whisper', 'sarvam'
DEFAULT_ROUTING_MODE=auto

# Vector Store Persistence Path
CHROMA_PERSIST_DIR=data/chroma_db
